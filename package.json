			"@types/pg": "^8.15.5",
			"@types/node": "^20.0.0"
		},
		"utilities": {
			"dotenv": "^17.2.3",
			"dotenv-expand": "^12.0.3",
			"tsx": "^4.20.6",
			"concurrently": "^9.2.1",
			"chokidar-cli": "^3.0.0",
			"wait-on": "^9.0.1",
			"nanoid": "^5.1.6",
