{
	"name": "ztunes",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"clean": "turbo clean && rm -rf node_modules .turbo dist bun.lock",
		"db:generate": "turbo run db:generate",
		"db:migrate": "turbo run db:migrate",
		"db:push": "turbo run db:push",
		"db:seed": "turbo run db:seed",
		"dev:clean": "turbo run dev:clean",
		"dev:db": "turbo run dev:db",
		"dev:ui": "turbo run dev:ui",
		"dev:zero": "turbo run dev:zero",
		"typecheck": "turbo run typecheck",
		"zero:generate": "turbo run zero:generate"
	},
	"dependencies": {
		"drizzle-orm": "catalog:backend"
	},
	"devDependencies": {
		"prettier": "^3.6.2",
		"turbo": "^2.5.6",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.0",
	"catalog": {
		"@rocicorp/zero": "0.24.2025100900",
		"drizzle-orm": "^0.44.6",
		"better-auth": "^1.3.27",
		"cookie": "^1.0.2",
		"dotenv": "^17.2.3",
		"jose": "^6.1.0",
		"pg": "^8.16.3",
		"zod": "^4.1.12",
		"typescript": "^5.9.3"
	},
	"catalogs": {
		"frontend": {
			"vite": "^7.1.9",
			"@tanstack/react-router": "^1.132.47",
			"@tanstack/react-start": "^1.132.52",
			"@tanstack/react-virtual": "^3.13.12",
			"@vitejs/plugin-react": "^5.0.4",
			"react": "^19.2.0",
			"react-dom": "^19.2.0",
			"react-cookie": "^8.0.1",
			"vite-tsconfig-paths": "^5.1.4"
		},
		"backend": {
			"drizzle-orm": "^0.44.6",
			"drizzle-kit": "^0.31.5",
			"postgres": "^3.4.7",
			"drizzle-zero": "0.14.3",
			"pg": "^8.16.3"
		},
		"types": {
			"@types/react": "^19.2.2",
